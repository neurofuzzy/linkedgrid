{
  "name": "linkedgrid",
  "version": "1.0.0",
  "description": "A linked-cell grid data structure for tile-based 2D games — pathfinding, distance fields, and neighbor queries",
  "type": "module",
  "main": "dist/spartan.js",
  "module": "dist/spartan.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/spartan.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "visual": "tsx tools/visual-runner/cli.tsx",
    "ai:map": "tsx scripts/generate-map.ts packages/spartan > .ai/PACKAGE_CONTENTS.md && tsx scripts/generate-map.ts packages/spartan-web > .ai/PLATFORM_WEB.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neurofuzzy/linkedgrid.git"
  },
  "keywords": [
    "grid",
    "pathfinding",
    "2d",
    "game",
    "tile",
    "arcade"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/neurofuzzy/linkedgrid/issues"
  },
  "homepage": "https://github.com/neurofuzzy/linkedgrid#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.1.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^11.0.0",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^2.1.8"
  }
}
