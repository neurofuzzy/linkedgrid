  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "glob": "^11.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
